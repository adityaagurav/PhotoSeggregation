# Environment variables for AI-Based Photo Segregation.
# Copy this file to `.env` and fill in values. Never commit the real `.env`.

# Directory used for runtime uploads (optional override)
# UPLOAD_DIR=data/uploads

# Directory for generated outputs (optional override)
# OUTPUT_DIR=data/output

# Similarity threshold used when clustering faces
# FACE_SIMILARITY_THRESHOLD=0.5

# Path to a pretrained model, if one needs to be referenced explicitly
# MODEL_PATH=ml/models/pretrained/
